{
  "name": "lumacare",
  "private": true,
  "version": "1.0.0",
  "description": "LumaCare — small steps, better days. A local-first self-care and anti-procrastination companion.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/gen-icons.js",
    "android:add": "cap add android",
    "ios:add": "cap add ios --packagemanager SPM",
    "mobile:sync": "npm run icons && npm run build && cap sync",
    "ios:sync": "npm run icons && npm run build && cap sync ios && node scripts/stamp-ios.js",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "ios:mac": "bash scripts/mac-ios.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
